# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHAT_REQUESTS=chat_requests
KAFKA_TOPIC_CHAT_RESPONSES=chat_responses
KAFKA_CONSUMER_GROUP=bcare-ai-answering
KAFKA_NUM_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# Redis (quota + idempotency)
REDIS_URL=redis://localhost:6379/0

# Quota theo tier
QUOTA_FREE_PER_DAY=2
QUOTA_PREMIUM_PER_DAY=5
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh
DEDUP_TTL_SECONDS=172800

# Chỉ bật ở local: mở /test/enqueue (bypass quota) để verify pipeline Phase 1
ENABLE_TEST_ENDPOINTS=false
