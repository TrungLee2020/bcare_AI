# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHAT_REQUESTS=chat_requests
KAFKA_TOPIC_CHAT_RESPONSES=chat_responses
KAFKA_CONSUMER_GROUP=bcare-ai-answering
KAFKA_TOPIC_DEAD_LETTER=chat_requests_dlq
KAFKA_NUM_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

# Redis (quota + idempotency)
REDIS_URL=redis://localhost:6379/0

# Quota theo tier
QUOTA_FREE_PER_DAY=2
QUOTA_PREMIUM_PER_DAY=5
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh
DEDUP_TTL_SECONDS=172800

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_ATTEMPTS=3
OPENAI_RETRY_BASE_DELAY=1.0
OPENAI_RETRY_MAX_DELAY=8.0

# SSE (SSE_PROCESSING_NOTICE_SECONDS phải nhỏ hơn OPENAI_TIMEOUT_SECONDS)
SSE_HEARTBEAT_SECONDS=15
SSE_PROCESSING_NOTICE_SECONDS=5
SSE_REPLAY_BUFFER_SIZE=20
SSE_REPLAY_TTL_SECONDS=3600

# Postgres (lịch sử chat)
DATABASE_URL=postgresql+asyncpg://bcare:bcare@localhost:5432/bcare
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Ngữ cảnh hội thoại (Phase 4)
HISTORY_WINDOW_MESSAGES=10
SUMMARY_TRIGGER_MESSAGES=20
SUMMARY_PROMPT_VERSION=v1
SUMMARY_MAX_CHARS=1500

# Prompt (file prompts/system_<version>.md) - đổi prompt không cần sửa code
PROMPT_VERSION=v2
ANSWER_MAX_CHARS=2000

# Xác thực (BẮT BUỘC ở production). AUTH_SECRET dùng chung với BE để verify
# token BE phát ra. AUTH_REQUIRED=false chỉ dành cho local.
AUTH_REQUIRED=true
AUTH_SECRET=

# Rollout dần: 0% = chỉ allowlist được dùng
ROLLOUT_ENABLED=true
ROLLOUT_PERCENTAGE=0
ROLLOUT_ALLOWLIST=

# Đơn giá OpenAI (USD / 1 triệu token) để ước tính chi phí.
# !! Đối chiếu lại với bảng giá hiện hành trước khi tin số liệu báo cáo.
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60

# Chỉ bật ở local: mở /test/enqueue (bypass quota) để verify pipeline Phase 1
ENABLE_TEST_ENDPOINTS=false
