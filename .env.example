# dev | production. production: từ chối khởi động nếu cấu hình còn là của
# môi trường test (thiếu secret, bật endpoint test, topic Kafka < 3 bản sao...)
APP_ENV=dev

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHAT_REQUESTS=chat_requests
KAFKA_TOPIC_CHAT_RESPONSES=chat_responses
KAFKA_CONSUMER_GROUP=bcare-ai-answering
KAFKA_TOPIC_DEAD_LETTER=chat_requests_dlq
# Số partition = trần số câu xử lý song song của cả hệ thống
KAFKA_NUM_PARTITIONS=24
# Production: 3 và 2. Giá trị 1 chỉ dành cho local.
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1
# APP_ENV=production đòi topic có sẵn >= ngần này bản sao. docker-compose.yml
# chỉ có 1 broker: đặt 1 ở đó (chấp nhận mất câu hỏi khi broker chết) thay vì
# để APP_ENV=dev — dev là tắt luôn mọi kiểm tra bảo mật lúc khởi động.
KAFKA_PRODUCTION_MIN_REPLICATION=3
# Số câu 1 instance xử lý cùng lúc. Theo rate limit OpenAI / số instance.
MAX_CONCURRENT_ANSWERS=16
KAFKA_MAX_BUFFERED_PER_PARTITION=50
# Câu hỏi nằm trong topic lâu hơn ngần này thì bỏ qua, không gọi OpenAI
REQUEST_MAX_AGE_SECONDS=600

# Redis (quota + idempotency). docker-compose.yml bắt buộc REDIS_PASSWORD và
# tự dựng REDIS_URL cho container app; dòng REDIS_URL dưới đây chỉ dùng khi
# chạy app ngoài Docker (kèm docker-compose.dev.yml).
# Chỉ dùng ký tự an toàn cho URL: openssl rand -hex 32
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

# Quota theo tier
QUOTA_FREE_PER_DAY=2
QUOTA_PREMIUM_PER_DAY=5
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh
DEDUP_TTL_SECONDS=172800

# OpenAI
OPENAI_API_KEY=
# Câu thứ 1 TRONG NGÀY của mỗi user dùng OPENAI_MODEL_FIRST (model mạnh); các
# câu sau và bước tóm tắt phiên dùng OPENAI_MODEL (model nhỏ). Trống = mọi câu
# dùng OPENAI_MODEL.
OPENAI_MODEL=gpt-5-nano
OPENAI_MODEL_FIRST=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_OUTPUT_TOKENS=1000
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_ATTEMPTS=3
OPENAI_RETRY_BASE_DELAY=1.0
OPENAI_RETRY_MAX_DELAY=8.0

# SSE (SSE_PROCESSING_NOTICE_SECONDS phải nhỏ hơn OPENAI_TIMEOUT_SECONDS)
SSE_HEARTBEAT_SECONDS=15
SSE_PROCESSING_NOTICE_SECONDS=5
SSE_REPLAY_BUFFER_SIZE=20
SSE_REPLAY_TTL_SECONDS=3600
# Kết nối SSE mới vẫn nhận câu trả lời phát ra trong ngần này giây gần nhất
SSE_REPLAY_ON_CONNECT_SECONDS=10
# Trần kết nối SSE mỗi user, và thời gian sống tối đa của 1 kết nối (giây)
SSE_MAX_CONNECTIONS_PER_USER=5
SSE_MAX_CONNECTION_SECONDS=1800

# Postgres (lịch sử chat). docker-compose.yml bắt buộc POSTGRES_PASSWORD (không
# còn mặc định bcare/bcare) và tự dựng DATABASE_URL cho container app.
# Chỉ dùng ký tự an toàn cho URL: openssl rand -hex 32
POSTGRES_USER=bcare
POSTGRES_PASSWORD=
POSTGRES_DB=bcare
DATABASE_URL=postgresql+asyncpg://bcare:<POSTGRES_PASSWORD>@localhost:5432/bcare
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Ngữ cảnh hội thoại (Phase 4)
HISTORY_WINDOW_MESSAGES=10
# Trần độ dài mỗi message cũ khi chở lại vào prompt (chặn user tự bơm chi phí)
HISTORY_MESSAGE_MAX_CHARS=600
SUMMARY_TRIGGER_MESSAGES=20
SUMMARY_TRANSCRIPT_MAX_CHARS=8000
SUMMARY_PROMPT_VERSION=v3
SUMMARY_MAX_CHARS=1500
# Tóm tắt thất bại thì chờ thêm ngần này message mới thử lại
SUMMARY_RETRY_AFTER_MESSAGES=6

# Prompt (file prompts/system_<version>.md) - đổi prompt không cần sửa code
PROMPT_VERSION=v4
ANSWER_MAX_CHARS=2000

# Xác thực (BẮT BUỘC ở production). AUTH_REQUIRED=false chỉ dành cho local.
AUTH_REQUIRED=true
# Token HMAC cũ cho /chat/* (công cụ dev). Trống = tắt loại token này.
AUTH_SECRET=

# Supabase của app (token /v1/* là access token Supabase của người dùng).
# Project ký bằng signing key (ES256/RS256): chỉ cần SUPABASE_URL (tải JWKS).
# Project còn ký bằng JWT secret cũ (HS256): đặt thêm SUPABASE_JWT_SECRET.
SUPABASE_URL=https://zkqoaxfueiojwtvvoaov.supabase.co
SUPABASE_JWT_SECRET=
# Đọc user_consents qua PostgREST. Chỉ ở server, không bao giờ đưa cho app.
SUPABASE_SERVICE_ROLE_KEY=

# Đồng ý riêng cho AI (user_consents.ai_chat_version / ai_share_profile).
# false CHỈ khi migration 20261010010000_ai_chat_consent chưa deploy.
CONSENT_REQUIRED=true
# Trống = có ai_chat_version là được; đặt giá trị = bắt buộc đúng version đó.
CONSENT_REQUIRED_VERSION=
CONSENT_CACHE_SECONDS=60

# /v1/chat chờ câu trả lời tối đa (giây), < proxy_read_timeout của nginx /v1/
V1_ANSWER_TIMEOUT_SECONDS=120
HEALTH_CONTEXT_MAX_CHARS=2000

# /v1/report/monthly
REPORT_PROMPT_VERSION=v1
REPORT_MAX_PER_DAY=5

# Rollout dần: 0% = chỉ allowlist được dùng. Allowlist = user_id (UUID Supabase), cách nhau bằng dấu phẩy
ROLLOUT_ENABLED=true
ROLLOUT_PERCENTAGE=0
ROLLOUT_ALLOWLIST=

# Đơn giá OpenAI (USD / 1 triệu token) để ước tính chi phí.
# !! Đối chiếu lại với bảng giá hiện hành trước khi tin số liệu báo cáo.
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60
# Đơn giá riêng từng model "model=in,out;model2=in,out" (USD/1M token), để chi
# phí trên /metrics đúng khi dùng 2 model. Model thiếu ở đây -> giá chung ở trên.
MODEL_PRICES=gpt-5-nano=0.05,0.4

# Chỉ bật ở local: mở /test/enqueue (bypass quota) để verify pipeline Phase 1
ENABLE_TEST_ENDPOINTS=false

# Bearer token để đọc /metrics. Production bắt buộc đặt.
METRICS_TOKEN=

# Port của app trên host (docker-compose.yml). Mặc định chỉ 127.0.0.1: hệ thống
# ngoài vào qua reverse proxy có TLS. 0.0.0.0 chỉ khi đã có TLS phía trước.
APP_BIND=127.0.0.1
APP_PORT=8000
